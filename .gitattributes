# Every text file checks out with LF on every OS, so golden files, the
# README and the Dockerfile read the same on Windows (whose git turns LF
# into CRLF by default) as they do on Linux and macOS.
* text=auto eol=lf

# Raw emails keep the CRLF line ends SMTP gives them, byte for byte.
*.eml -text

# Consent goldens, HAR files and testbed pages compare byte for byte on
# every OS; screenshots are never touched.
*.golden -text eol=lf
*.png binary
*.har -text eol=lf
testbed/consent/**/*.html eol=lf

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RhythmShahriar/echo/report/schema/consent.schema.json",
  "title": "rhythm-echo/v1 consent",
  "description": "What `consent --json` writes; data is also consent.json. Generated from the Go types (report/consent_schema_test.go). New optional fields may be added without a new schema name.",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "tool",
    "version",
    "complete",
    "summary",
    "verdict",
    "data"
  ],
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/result"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "properties": {
        "exit": {
          "description": "2 usage error, 3 couldn't check",
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "exit",
        "message"
      ],
      "type": "object"
    },
    "kind": {
      "const": "consent"
    },
    "schema": {
      "const": "rhythm-echo/v1"
    },
    "summary": {
      "properties": {
        "after_reject": {
          "description": "How many different consent-needing trackers sent a hit after Reject (trackers, not hits).",
          "minimum": 0,
          "type": "integer"
        },
        "before_choice": {
          "description": "How many different consent-needing trackers sent a hit before the visitor chose (trackers, not hits).",
          "minimum": 0,
          "type": "integer"
        },
        "broke": {
          "minimum": 0,
          "type": "integer"
        },
        "changed": {
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "failed_runs": {
          "minimum": 0,
          "type": "integer"
        },
        "fixed": {
          "minimum": 0,
          "type": "integer"
        },
        "held": {
          "minimum": 0,
          "type": "integer"
        },
        "inconclusive_runs": {
          "minimum": 0,
          "type": "integer"
        },
        "new": {
          "minimum": 0,
          "type": "integer"
        },
        "notices": {
          "minimum": 0,
          "type": "integer"
        },
        "pages": {
          "minimum": 0,
          "type": "integer"
        },
        "runs": {
          "minimum": 0,
          "type": "integer"
        },
        "trackers": {
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "broke",
        "new",
        "changed",
        "fixed",
        "errors",
        "warnings",
        "notices",
        "pages",
        "runs",
        "failed_runs",
        "inconclusive_runs",
        "trackers",
        "before_choice",
        "after_reject",
        "held"
      ],
      "type": "object"
    },
    "tool": {
      "const": "rhythm-echo"
    },
    "verdict": {
      "enum": [
        "ok",
        "findings",
        "error"
      ]
    },
    "version": {
      "type": "string"
    }
  },
